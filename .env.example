# Root docker-compose configuration for both sites.
# Copy this file to .env and fill in real values locally or on the server.

# Portfolio / EmailJS
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Utulna / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
